[run]
branch = True
source =
    accounts
    complaints
    config
omit =
    */migrations/*
    */tests/*
    config/test_settings.py
    config/asgi.py
    config/wsgi.py

[report]
show_missing = True
skip_empty = True
precision = 2

[html]
directory = Docs/reports/coverage_html
title = SCMS Code & Branch Coverage
